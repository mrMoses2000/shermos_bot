# Frontend API base URL.
# - For local dev with the backend serving SPA on same origin: leave empty.
# - For Netlify deploy: set to the public backend URL, e.g.
#   VITE_API_BASE_URL=https://carb-investigation-drive-equations.trycloudflare.com
# Vite picks up VITE_*-prefixed vars at build time only (not runtime).
VITE_API_BASE_URL=
